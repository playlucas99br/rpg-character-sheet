# Vercel/Next.js: public values for Supabase Auth (never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public endpoint. Each operation is authorized with the player's Supabase session.
NEXO_GAME_API_URL=
# Administrative credentials remain inside Supabase; Vercel needs no database secret.
